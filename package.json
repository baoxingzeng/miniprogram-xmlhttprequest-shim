{
  "name": "miniprogram-xmlhttprequest-shim",
  "version": "1.0.3",
  "license": "MIT",
  "author": "Xingzeng Bao",
  "homepage": "https://github.com/baoxingzeng/miniprogram-xmlhttprequest-shim",
  "description": "W3C-compliant XMLHttpRequest polyfill for mini programs.",
  "type": "module",
  "main": "dist/miniprogram-xmlhttprequest-shim.cjs.js",
  "module": "dist/miniprogram-xmlhttprequest-shim.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "!dist/types/**/*",
    "!dist/cjs/types/**/*",
    "!dist/esm/types/**/*"
  ],
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dev": {
      "require": "./dist/cjs/dev.js",
      "import": "./dist/esm/dev.js",
      "types": "./dist/dev.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rollup --config",
    "test": "echo \"Follow the instructions in tests/README.txt to run the tests.\" && exit 1"
  },
  "keywords": [
    "miniprogram",
    "xmlhttprequest",
    "polyfill"
  ],
  "dependencies": {
    "fetch-xhr-shim": ">=1.0.0",
    "miniprogram-platform": ">=1.0.0",
    "set-cookie-parser": "^3.1.0",
    "url-parse": "^1.5.10",
    "valid-url": "^1.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/url-parse": "^1.4.11",
    "@types/valid-url": "^1.0.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "formidable": "^3.5.4",
    "rollup": "^4.61.0",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "uvu": "^0.5.6"
  }
}
